{{/* Override of Hugo's built-in sitemap template, kept deliberately close to it
     so it stays easy to diff against upstream. It leaves out author profiles that
     custom_head.html marks noindex (same condition there), so the sitemap never
     lists a page it asks search engines not to index (check 14 in
     scripts/check_seo_html.py). */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
  {{- if and (eq .Section "authors") .Params.name (not (partial "authors/is-substantive.html" .)) }}{{ continue }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
      {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}" />
      {{- end }}
    {{- end }}
  </url>
  {{- end }}
</urlset>
